# ============================================================
# Copy this file, rename the copy to ".env", and fill it in.
# You need AT LEAST ONE key. More keys = more backup if one AI fails.
# ============================================================

# 1) Google Gemini (free) — can READ PHOTOS of homework
#    Get a key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# 2) Groq (free) — VERY FAST, good at writing the lesson
#    Get a key: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Set to true only if you pick a Groq model that can see images
GROQ_VISION=false

# 3) OpenRouter (free models end in ":free") — backup brain
#    Get a key: https://openrouter.ai/keys
#    Find free models: https://openrouter.ai/models?q=free
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_VISION=false

# ------------------------------------------------------------
# Which AI does which job? (first one tried first, the rest are backups)
# Planner = thinks + solves (private notes). Teacher = turns notes into board steps.
# ------------------------------------------------------------
PLANNER_ORDER=gemini,groq,openrouter
TEACHER_ORDER=groq,gemini,openrouter

# Optional: a password so strangers can't use up your free AI limits.
# Leave empty for no password.
APP_PASSWORD=

PORT=3000
